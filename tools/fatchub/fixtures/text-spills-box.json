{
  "name": "text-spills-box",
  "why": "A label whose box extends past its clipping card must be an error, not a shrug.",
  "expect": [
    {
      "rule": "text-clipped",
      "severity": "error",
      "contains": "Wide caption"
    }
  ],
  "nodes": [
    {
      "class": "Frame",
      "name": "Window",
      "x": 100,
      "y": 100,
      "w": 320,
      "h": 160,
      "transparency": 0,
      "radius": 0,
      "fill": [
        0.1,
        0.1,
        0.12
      ],
      "z": 1
    },
    {
      "class": "Frame",
      "name": "Card",
      "x": 120,
      "y": 128,
      "w": 180,
      "h": 40,
      "transparency": 0,
      "radius": 6,
      "fill": [
        0.16,
        0.16,
        0.19
      ],
      "z": 2
    },
    {
      "class": "TextLabel",
      "name": "Caption",
      "x": 130,
      "y": 136,
      "w": 260,
      "h": 20,
      "transparency": 1,
      "radius": 0,
      "fill": [
        1,
        1,
        1
      ],
      "z": 3,
      "text": "Wide caption that escapes the card",
      "size": 13,
      "align": "Left",
      "valign": "Center",
      "font": "Gotham",
      "color": [
        0.94,
        0.94,
        0.95
      ],
      "clip": [
        {
          "x": 120,
          "y": 128,
          "w": 180,
          "h": 40,
          "stroke": 0
        },
        {
          "x": 100,
          "y": 100,
          "w": 320,
          "h": 160,
          "stroke": 0
        }
      ]
    }
  ]
}
